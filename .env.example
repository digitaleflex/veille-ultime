# Neon PostgreSQL connection strings. Copy to .env.local and fill locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Admin credentials: generate a long random secret for each environment.
VEILLE_ADMIN_PASSWORD="replace-with-a-long-unique-password"
VEILLE_ADMIN_SESSION_SECRET="replace-with-at-least-32-random-bytes"
